#
# @synopsis: export-filters-to <path>
# @description: Export current filters and highlights to an lnav script.
#

;SELECT raise_error('expecting output path as the first argument') WHERE $1 IS NULL
:redirect-to /dev/null
:export-session-to /tmp/lnav-filter-session.lnav
;SELECT ':sh awk ''/^;REPLACE INTO lnav_view_filters / { if ($0 ~ /VALUES \(\047log\047, 1, \047in\047/) in_enabled[++ie] = $0; else if ($0 ~ /VALUES \(\047log\047, 0, \047in\047/) in_disabled[++id] = $0; else if ($0 ~ /VALUES \(\047log\047, 1, \047out\047/) out_enabled[++oe] = $0; else if ($0 ~ /VALUES \(\047log\047, 0, \047out\047/) out_disabled[++od] = $0; next } /^# :highlight / { sub(/^# /, "", $0); highlights[++hi] = $0; next } END { print "# filters:"; print ""; print "# filter-in"; print "# enabled"; for (i = 1; i <= ie; i++) print in_enabled[i]; print ""; print "# disabled"; for (i = 1; i <= id; i++) print in_disabled[i]; print ""; print "# filter-out"; print "# enabled"; for (i = 1; i <= oe; i++) print out_enabled[i]; print ""; print "# disabled"; for (i = 1; i <= od; i++) print out_disabled[i]; print ""; print "# highlights:"; for (i = 1; i <= hi; i++) print highlights[i] }'' /tmp/lnav-filter-session.lnav > ' || $1 AS export_filters_cmd
:eval ${export_filters_cmd}
:redirect-to
