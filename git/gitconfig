[include]
    path = /Volumes/Workspace/dotfiles/git/themes.gitconfig

[http]
    sslBackend = openssl

[user]
    name = STAR-H
    email = user@example.invalid

[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true

[difftool]
    prompt = true

[diff]
    tool = nvimdiff

[difftool "meld"]
    cmd = "meld \"$LOCAL\" \"$REMOTE\""

[difftool "nvimdiff"]
    cmd = "nvim -d \"$LOCAL\" \"$REMOTE\""

[init]
    defaultBranch = main

[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    features = chameleon
    navigate = true  # use n and N to move between diff sections

[merge]
    conflictStyle = zdiff3
