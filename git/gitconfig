[http]
    sslBackend = openssl
[user]
    name = STAR-H
    email = user@example.invalid
[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true
[difftool]
    prompt = true
[diff]
    tool = nvimdiff
[difftool "meld"]
    cmd = "meld \"$LOCAL\" \"$REMOTE\""
[difftool "nvimdiff"]
    cmd = "nvim -d \"$LOCAL\" \"$REMOTE\""
